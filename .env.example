# The local preview runs with an on-disk account database and a generated secret.
# Public sign-in uses the deployed HTTPS origin, a random server secret and SMTP.
# Keep all credentials in .env.local or the host's server-side environment.
NOCTIS_URL=
NOCTIS_BIND_ADDRESS=
BETTER_AUTH_SECRET=
NOCTIS_AUTH_DATA_DIR=
# Persistent PostgreSQL for the Vercel deployment.
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOCTIS_SMTP_URL=
NOCTIS_MAIL_FROM=
