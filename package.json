{
  "name": "noctis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:google": "vite --mode google --host 127.0.0.1 --port 5176 --strictPort",
    "build": "node scripts/create-icons.mjs && tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "check": "tsc -b",
    "format": "prettier --write src tests scripts *.json *.ts *.md index.html public/manifest.webmanifest .vscode/tasks.json",
    "start": "node server/start.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "better-auth": "^1.7.23",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sirv": "^3.0.2",
    "suncalc": "^2.1.1"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "smtp-server": "^3.21.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
